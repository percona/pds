# Adapter HTTP listen address (local dev)
ADAPTER_ADDR=localhost:8080

# Everest API base URL, without the /v1 prefix. The agent on a connected
# environment calls this. A hub leaves it empty: database changes are commits,
# and the HTTP role does not call OpenEverest.
# EVEREST_URL=http://everest.everest-system.svc.cluster.local:8080

# Everest bearer token, sent as Authorization: Bearer. The agent uses it
# when it cannot mint one from the everest-accounts Secret. Leave it unset
# on a hub.
# EVEREST_TOKEN=

# OpenEverest API name the agent scopes calls under. The default is main.
EVEREST_CLUSTER=main

# Everest managed namespace new databases land in. It is also the only
# namespace a create request may target.
EVEREST_NAMESPACE=pds

# Everest BackupStorage backups and schedules are written to. Empty leaves
# backups off, which is the default: nothing in this repository creates a
# BackupStorage, and Everest rejects a backup naming one that does not exist.
EVEREST_BACKUP_STORAGE=

# Everest MonitoringConfig new instances scrape through. Empty leaves
# pmm-client off, so metrics stay pending until you set this to an existing
# MonitoringConfig name (the chart uses pmm when PMM is wired).
EVEREST_MONITORING_CONFIG=

# PMM API base URL. The agent on a connected environment reads this. The HTTP
# role charts the samples that agent posts and does not call PMM. Leave it
# unset on a hub. Unset on an agent means metrics are posted as pending.
# PMM_URL=

# PMM Grafana service account token, sent as Authorization: Bearer. PMM 3
# replaced API keys with service accounts. The agent uses it. Anonymous
# reads only work against a PMM that allows them.
# PMM_TOKEN=

# OIDC issuer URL. Empty keeps the password login only. Set, people can also
# sign in through the issuer; OIDC_CLIENT_ID and OIDC_CLIENT_SECRET are the
# adapter's registration there, and OIDC_SCOPES (space separated) defaults to
# "openid email profile".
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# ServiceNow tokens for the Percona Connector, both provisioned per account by
# Percona. Unset means /api/support/tickets answers 501 and the UI hides the
# support actions, which is a supported configuration. Test tokens belong to a
# non-production ServiceNow instance, never to a production one.
# SN_API_KEY=your-api-key-here
# SN_CLIENT_TOKEN=your-client-token-here

# ServiceNow instance support cases go to. Required for support: unset means
# the support routes answer 501 even with both tokens. It has to be HTTPS: both
# tokens travel on every call, so the adapter refuses to start on a plaintext
# instance.
# SN_URL=https://example.service-now.com

# Chat's Claude and Cursor providers have no environment key: each Organization
# pastes its own on the connections panel, and the adapter database keeps it
# sealed.
#
# Secret names the adapter writes when a token is pasted and there is no
# database. Defaults match the chart.
# SN_SECRET_NAME=pds-servicenow
# ASSISTANT_SECRET_NAME=pds-assistant
# CURSOR_SECRET_NAME=pds-cursor
# POD_NAMESPACE=pds

# ADAPTER_ROLE=agent runs the heartbeat loop on a connected environment.
# Leave it unset, or set http, for the hub API. The HTTP role requires
# the hub settings below.
# ADAPTER_ROLE=http

# Activity log. Every database and connection mutation is appended to a bounded
# ring in this ConfigMap, so the feed survives an adapter restart. Without
# cluster access the ring is kept in memory instead and is lost on restart.
# ACTIVITY_CONFIGMAP=pds-activity

# The HTTP role is a hub. It refuses to start without a Git backend and
# HUB_PUBLIC_URL. Set HUB_GIT_DIR, or HUB_GITHUB_ORG and HUB_GITHUB_TOKEN,
# and set HUB_PUBLIC_URL. Do not set both backends: that is a fatal start
# error. HUB_GIT_DIR is the desired-state tree the hub writes Instance YAML
# into and Flux on each connected environment pulls from. A GitHub hub creates
# one private repository per environment and leaves HUB_GIT_DIR unset.
# HUB_GIT_DIR=
# HUB_GITHUB_ORG=
# HUB_GITHUB_TOKEN=
# Or authenticate as a GitHub App installation: set all three, never with
# HUB_GITHUB_TOKEN. The key is PEM text; HUB_GITHUB_APP_PRIVATE_KEY_FILE reads
# it from a file instead.
# HUB_GITHUB_APP_ID=
# HUB_GITHUB_APP_INSTALLATION_ID=
# HUB_GITHUB_APP_PRIVATE_KEY=
# HUB_REGISTRY_TOKEN is a packages token for private ghcr.io agent images.
# Leave it unset rather than reusing HUB_GITHUB_TOKEN: enrollment would
# otherwise copy the org credential onto every connected environment.
# HUB_REGISTRY_TOKEN=
# HUB_PUBLIC_URL is the origin a connected environment reaches this hub on. The
# HTTP role refuses to start without it, so join commands cannot take the
# request Host. HUB_GIT_URL is a Git URL a connected environment can clone when
# the hub writes a local tree. A GitHub hub derives clone URLs from the org
# and does not need HUB_GIT_URL. A value is checked for shell-safe characters
# when set. HUB_PUBLIC_URL is still required.
# HUB_PUBLIC_URL=
# HUB_GIT_URL=
# The image a connected environment installs for its agent. Connect refuses to
# build an EKS cluster without it, rather than finding out after eksctl has run.
# A Helm hub sets this from adapter.image when adapter.hub.agentImage is
# empty. A private ghcr.io image is pulled with HUB_REGISTRY_TOKEN.
# HUB_AGENT_IMAGE=
# Default AWS region for a Connect command.
# HUB_CLUSTER_REGION=us-west-2
# How long a minted join token stays valid. Zero never expires. Disconnecting
# an environment revokes its tokens whatever this is set to.
# HUB_JOIN_TOKEN_TTL=24h
# How long after its last heartbeat a connected environment reads as unreachable.
# HUB_HEARTBEAT_STALE=90s
# Hashed join tokens live in a Secret. Inventory snapshots are one ConfigMap
# per environment (<HUB_INVENTORY_CONFIGMAP>-<name>); the prefix object lists names.
# HUB_JOIN_SECRET=pds-join-tokens
# HUB_INVENTORY_CONFIGMAP=pds-hub-inventory
# A shared agent token, and the environments it may act for. Prefer the
# per-environment join tokens the hub mints. An empty environment list is not
# a wildcard: the shared token then authorizes nothing.
# HUB_AGENT_TOKEN=
# HUB_AGENT_ENVIRONMENTS=
# Shared secret that authorizes minting join tokens and disconnecting
# environments. Required when this process is a hub (HUB_GIT_DIR or GitHub).
# HUB_OPERATOR_TOKEN=

# Agent (ADAPTER_ROLE=agent). HUB_URL is the hub origin this environment dials,
# and ENVIRONMENT_NAME is the name the hub lists it under. The agent refuses to
# start without both.
# HUB_URL=
# ENVIRONMENT_NAME=

# scripts/up.sh --kubeconfig --hub pushes the images it builds here. The
# adapter does not read this. A prefix only, no scheme and no trailing slash.
# IMAGE_REGISTRY=ghcr.io/your-org
