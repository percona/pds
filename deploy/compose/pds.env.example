# Template for pds.env, which sits next to compose.yaml and holds the
# configuration and secrets the adapter container reads. Copy it, fill the
# blanks, chmod 600. An upgrade does not rewrite it: only version.env changes,
# and that holds the image tag.
#
# Every key here is read by the adapter itself. Whoever owns secrets decides
# where the values come from; this file is only the shape they land in.
#
# Compose reads this file, and it expands $NAME in a value that is not quoted.
# Wrap any value that holds a $ in single quotes, or write it as $$, or a
# password with a $ in it reaches the adapter cut short.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Listen address. Keep the empty host: localhost:8080 would bind loopback
# inside the container's own namespace, and the published port would then
# reach nothing.
ADAPTER_ADDR=:8080

# JSON logs. The only other accepted value is dev, and anything else is a
# fatal start error.
ADAPTER_ENV=prod
ADAPTER_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL the adapter keeps its own state in: sessions, password hashes,
# organizations, environments and sealed downstream credentials. Required, and a value
# that is set but empty is a fatal start error rather than "no database".
#
# sslmode=require encrypts without verifying the certificate. Raise it to
# verify-full once the database's CA bundle is on the host.
#
# The value is fixed when the container is created, and `docker compose
# restart` keeps the old one. After any rotation recreate the stack with
# `docker compose --env-file version.env up -d --force-recreate`.
DATABASE_URL=postgres://pds:CHANGEME@db.example.com:5432/pds?sslmode=require

# Base64 of exactly 32 random bytes, sealing the replayable credentials in the
# database with AES-256-GCM. Required whenever DATABASE_URL is set. Losing it
# makes every sealed row unreadable.
#
#   openssl rand -base64 32
STATE_ENCRYPTION_KEY=

# Comma separated retired keys, read only, so a key can be rotated without
# rewriting rows.
# STATE_ENCRYPTION_KEYS_RETIRED=

# ---------------------------------------------------------------------------
# Tenancy
# ---------------------------------------------------------------------------

# A star serves every organization that has a row, which is what one deployment
# shared by several customers means. The operator onboards each one with
# `adapter organization create <id>`; nothing on the API surface creates a password login.
#
# This is not a flag that can be flipped later: the organization id leads every
# primary key in the database.
#
# A star skips the ConfigMap activity ring, which cannot be shared across
# organizations. Activity itself stays on: it reads the database, and its flag
# still gates the route.
HUB_ORGANIZATION=*

# ---------------------------------------------------------------------------
# Hub
# ---------------------------------------------------------------------------

# The origin a browser and a customer environment both reach this deployment on.
# A hub refuses to start without it, so a join command can never take the
# request Host. It must be a bare origin: scheme and host, no path or query.
#
# It also decides the Secure flag on the session cookie, which is why it has
# to start with https:// even though this stack itself serves plain HTTP.
HUB_PUBLIC_URL=https://pds.example.com

# Optional. The address agents and people use as the OAuth issuer, when it differs from
# HUB_PUBLIC_URL. Leave it unset: the public URL is used.
# HUB_OAUTH_ISSUER=

# The GitHub org holding one private repository per joined environment. The HTTP
# role refuses to start without this pair, or HUB_GIT_DIR, and without
# HUB_PUBLIC_URL. It needs no volume: the desired state is committed over the
# GitHub API rather than kept on disk.
#
# Do not also set HUB_GIT_DIR. Both at once is a fatal start error.
HUB_GITHUB_ORG=your-github-org
HUB_GITHUB_TOKEN=CHANGEME

# A deployment that should not depend on a person's token authenticates as a
# GitHub App installed on the org instead (Administration write, Contents
# write, Metadata read). Empty HUB_GITHUB_TOKEN, then set all three. The key
# is the PEM on one line with literal \n between lines, or point
# HUB_GITHUB_APP_PRIVATE_KEY_FILE at a mounted file instead. Setting a token
# and the App together is a fatal start error.
HUB_GITHUB_APP_ID=
HUB_GITHUB_APP_INSTALLATION_ID=
HUB_GITHUB_APP_PRIVATE_KEY=

# A packages:read token for the private ghcr.io agent image, handed to every
# environment that joins. Leave it empty, or set it equal to HUB_GITHUB_TOKEN,
# and enrollment sends no pull secret: the joined environment cannot pull the
# agent. It never copies the org token onto an environment.
#
# Only a token that is set can be compared. With the HUB_GITHUB_APP_* settings
# there is no HUB_GITHUB_TOKEN, so a registry token equal to the old one would
# be sent to every environment as its pull secret. When you switch to the App,
# empty HUB_REGISTRY_TOKEN or replace it with a separate packages:read token
# before you empty HUB_GITHUB_TOKEN.
HUB_REGISTRY_TOKEN=

# HUB_AGENT_IMAGE, the agent a joining environment installs, is not set here.
# compose.yaml sets it to the adapter image of the tag being deployed, so it
# follows every release and rollback, and a value here is overridden.

# Managed environments are refused until both are set. The first lists the
# addresses this control plane's AWS calls come from, as comma separated CIDRs.
# The second is a pds chart version published to oci://ghcr.io/percona/charts.
HUB_MANAGED_OUTGOING_CIDRS=
HUB_MANAGED_CHART_VERSION=

# Shared secret that authorizes minting join tokens and disconnecting
# environments for a caller that has no session cookie, which means a script.
# Pin it: left empty, a fresh one is minted on every start, so anything
# scripted against those routes breaks on every deploy.
#
# On a star pin it gets past the door but carries no organization, so it cannot
# read organization scoped data. A request for one answers 502, not 401.
#
#   openssl rand -hex 32
HUB_OPERATOR_TOKEN=

# Default AWS region substituted into the EKS cluster creation script this
# deployment hands a customer. Set the region your customers create EKS in.
HUB_CLUSTER_REGION=us-west-2

# How long a minted join token stays valid, and how long after its last
# heartbeat an environment reads as unreachable. Defaults shown.
# HUB_JOIN_TOKEN_TTL=24h
# HUB_HEARTBEAT_STALE=90s

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# Absolute cap and idle window on a signed-in session, and how long an invite
# link stays claimable. Defaults shown. The idle window has to be at or below
# the lifetime.
# SESSION_LIFETIME=720h
# SESSION_IDLE_TIMEOUT=168h
# INVITE_TTL=48h

# Invitations an Organization admin makes. The link is shown to the admin; it
# is also emailed through Resend when RESEND_API_KEY and INVITATION_FROM are
# both set. Default life 7 days; an any-email invitation lives 48 hours.
# INVITATION_TTL=168h
# INVITATION_FROM=PDS <invites@example.com>
# RESEND_API_KEY is the Resend API key. You write it here. Leave it empty to
# show the link to the admin without emailing it.
RESEND_API_KEY=

# Support access network. All six are needed together; leave them unset to
# make no network call. With only some set, the hub starts with support access
# off and logs a warning naming the missing ones. The two client secrets come
# from your secrets store, never from this file. The tags default to tag:pds-environment and tag:pds-support.
# SUPPORT_TAILNET=
# SUPPORT_TAILNET_DOMAIN=
# SUPPORT_TAILNET_KEY_CLIENT_ID=
# SUPPORT_TAILNET_KEY_CLIENT_SECRET=
# SUPPORT_TAILNET_SERVICE_CLIENT_ID=
# SUPPORT_TAILNET_SERVICE_CLIENT_SECRET=
# SUPPORT_TAILNET_URL=https://api.tailscale.com

# Optional. An https address the case note and the console's share text give an
# engineer for the connection steps. Empty leaves the line out.
SUPPORT_GUIDE_URL=

# ---------------------------------------------------------------------------
# Surfaces
# ---------------------------------------------------------------------------

# These mirror charts/pds/values.yaml, which is the record of which
# surfaces a hub serves. Naming an unknown surface is a fatal start error, so
# a typo is caught at start rather than at runtime. A flag whose surface was
# deleted is ignored for one release, with a warning, and refused after that.
#
# Databases, clusters, backups, connections, support, chat, the assistant,
# metrics and mcp stay on, and are on by default, so they are not named.
# Support access is on only when the SUPPORT_TAILNET settings below are all
# set; without them it is off whatever ADAPTER_FEATURE_SUPPORT_ACCESS says. Metrics come
# from the readings each environment's agent posts with its heartbeat. Activity is
# on because it reads the adapter database.
ADAPTER_FEATURE_ACTIVITY=true

# ---------------------------------------------------------------------------
# Deliberately unset
# ---------------------------------------------------------------------------

# KUBERNETES_SERVICE_HOST tells the adapter it is running inside a cluster.
# This stack has no cluster, so it stays unset.
#
# OIDC_ISSUER stays unset here: this stack signs in with the password login.
#
# EVEREST_URL and PMM_URL belong to a cluster this deployment does not have.
#
# SN_API_KEY, SN_CLIENT_TOKEN and the AI provider keys are left out on
# purpose: pasted in the UI they are sealed with STATE_ENCRYPTION_KEY, kept in
# the database and survive a redeploy, so no one has to edit a file on the
# host to change one.
